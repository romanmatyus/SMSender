{
	"name": "rm/smsender",
	"type": "library",
	"description": "Library for sending SMS",
	"homepage": "https://github.com/romanmatyus/SMSender",
	"license": ["MIT"],
	"authors": [
		{
			"name": "Roman Mátyus",
			"homepage": "http://romiix.org",
			"email": "romanmatyus@romiix.org"
		}
	],
	"support": {
		"email": "romanmatyus@romiix.org",
		"issues": "https://github.com/romanmatyus/SMSender/issues"
	},
	"require": {
		"php": ">=7.1",
		"ext-intl": "*",
		"guzzlehttp/guzzle": ">=6.3",
		"nette/utils": ">=2.4"
	},
	"suggest": {
		"nette/di": "If you wanna use Nette DI extension"
	},
	"require-dev": {
		"phpstan/phpstan": ">=0.9",
		"nette/caching": ">=2.5",
		"nette/finder": ">=2.4",
		"nette/di": ">=2.4",
		"nette/bootstrap": ">=2.4",
		"nette/neon": ">=2.4",
		"nette/tester": ">=2.0",
		"php-parallel-lint/php-parallel-lint": "^1.0"
	},
	"autoload": {
		"psr-0": {
			"RM\\SMSender": "src/"
		},
		"classmap": [
			"src/RM/SMSender/exceptions.php"
		]
	},
	"scripts": {
		"tester": "tester tests -s -C",
		"phpstan": "phpstan analyse",
		"lint": "parallel-lint -e php,phpt --exclude vendor ."
	}
}
